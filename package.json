{
  "name": "nano-staged",
  "version": "1.0.2",
  "description": "Tiny tool to run commands for modified, staged, and committed git files.",
  "author": "Usman Yunusov <usman.iunusov@gmail.com>",
  "license": "MIT",
  "repository": "usmanyunusov/nano-staged",
  "type": "module",
  "bin": "./lib/bin.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "types": "./lib/index.d.ts",
  "engines": {
    "node": "^22 || >= 24"
  },
  "scripts": {
    "lint": "prettier --write lib/**/*.js",
    "unit": "cross-env CI=true node --loader=esmock --no-warnings ./node_modules/uvu/bin.js test \"\\.test\\.js$\"",
    "test": "c8 pnpm unit",
    "bench": "node bench/running-time/index.js && node bench/size/index.js",
    "publish": "clean-publish --package-manager pnpm -- --no-git-checks"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "clean-publish": "^6.0.5",
    "cross-env": "^10.1.0",
    "esmock": "^2.7.3",
    "fs-extra": "^11.3.4",
    "nanoid": "^5.1.7",
    "prettier": "^3.8.1",
    "uvu": "^0.5.6"
  },
  "files": [
    "lib",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "clean-publish": {
    "cleanDocs": true
  },
  "prettier": {
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  },
  "c8": {
    "include": [
      "lib/**/*"
    ],
    "lines": 90,
    "check-coverage": true
  },
  "keywords": [
    "runner",
    "lint",
    "git",
    "staged",
    "unstaged",
    "diff",
    "eslint",
    "prettier",
    "stylelint"
  ]
}
