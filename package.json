{
  "name": "nano-staged",
  "version": "0.9.0",
  "description": "Tiny tool to run commands for modified, staged, and committed git files.",
  "author": "Usman Yunusov <usman.iunusov@gmail.com>",
  "license": "MIT",
  "repository": "usmanyunusov/nano-staged",
  "type": "module",
  "bin": "./lib/bin.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "types": "./lib/index.d.ts",
  "engines": {
    "node": "^22 || >= 24"
  },
  "scripts": {
    "lint": "prettier --write lib/**/*.js",
    "unit": "cross-env CI=true node --loader=esmock --no-warnings ./node_modules/uvu/bin.js test \"\\.test\\.js$\"",
    "test": "c8 pnpm unit",
    "bench": "node bench/running-time/index.js && node bench/size/index.js",
    "publish": "clean-publish"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "clean-publish": "^3.4.5",
    "cross-env": "^7.0.3",
    "esmock": "^2.7.2",
    "fs-extra": "^10.1.0",
    "nanoid": "^5.1.5",
    "prettier": "^3.6.2",
    "uvu": "^0.5.3"
  },
  "clean-publish": {
    "cleanDocs": true
  },
  "prettier": {
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  },
  "c8": {
    "include": [
      "lib/**/*"
    ],
    "lines": 90,
    "check-coverage": true
  },
  "keywords": [
    "runner",
    "lint",
    "git",
    "staged",
    "unstaged",
    "diff",
    "eslint",
    "prettier",
    "stylelint"
  ]
}
